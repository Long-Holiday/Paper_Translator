# ==========================================
# Paper Translator 环境变量配置模版（.env.example）
# 使用方法：复制本文件为 .env 并填入您的真实密码与 API 密钥
# 命令：cp .env.example .env
# ==========================================

# 1. 平台访问自用密码（免账号，输入该密码即可解锁访问）
PAPER_TRANSLATOR_PASSWORD=your_secure_password_here

# 2. LLM 翻译服务 API 密钥（如 DeepSeek/OpenAI 等平台的 API Key）
TRANSLATION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 1GB RAM + 8GiB Swap / 单人使用；覆盖 config.yaml 中 resources 同名配置
PT_CPU_THREADS=1
PT_MAX_TRANSLATION_THREADS=4
PT_TRANSLATION_BATCH_PAGES=5
PT_MAX_PENDING_TASKS=10
PT_MAX_UPLOAD_MB=100
PT_MAX_PDF_PAGES=1000
PT_TRANSLATION_TIMEOUT_SECONDS=7200
# Docker 容器上限（包含 API 与翻译子进程）
PT_CONTAINER_MEMORY=1g
# 内存 + Swap 总上限；5g 表示最多使用 4GiB Swap
PT_CONTAINER_MEMORY_SWAP=5g
PT_CONTAINER_CPUS=1.0
